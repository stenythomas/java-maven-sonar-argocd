pipeline {
  agent {
    docker {
      image 'jibin321/maven-docker-agent:v2'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
    }
  }
  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        //git branch: 'main', url: 'https://github.com/user/repo.git'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'cd spring-boot-app && mvn clean package'
      }
    }
stage('SonarQube Analysis') {
    steps {
        withSonarQubeEnv('sonarqube') {
            sh '''
                cd spring-boot-app
                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                  -Dsonar.projectKey=my-ec2-project \
                  -Dsonar.projectName="Spring Boot App" \
                  -Dsonar.host.url=$SONAR_HOST_URL
            '''
        }
    }
}

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "stenythomas/spring-boot-app:${BUILD_NUMBER}"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
      }
      steps {
        script {
            sh 'docker build -t ${DOCKER_IMAGE} ./spring-boot-app'
            
            def dockerImage = docker.image("${DOCKER_IMAGE}")
            docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                dockerImage.push()
                dockerImage.push("latest")
            }
        }
      }
    }

stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = "java-maven-sonar-argocd"
                GIT_USER_NAME = "stenythomas"
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        rm -rf gitops-repo

                        git clone https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git gitops-repo

                        cd gitops-repo

                        git config user.email "stenythomas163@gmail.com"
                        git config user.name "${GIT_USER_NAME}"

                        sed -i "s|image: .*|image: stenythomas/spring-boot-app:${BUILD_NUMBER}|g" spring-boot-app-manifests/deployment.yml

                        git add spring-boot-app-manifests/deployment.yml

                        git commit \
                            -m "Update Spring Boot image tag to ${BUILD_NUMBER} [skip ci]" \
                            || echo "No changes to commit"

                        git push origin HEAD:main
                    '''
                }
            }
        }
    }
}
